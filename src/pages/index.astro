---
import BaseLayout from "../layouts/BaseLayout.astro";

const profileImage = "/images/profile-laurenz.jpg";

const site = {
  name: "Laurenz Gebauer",
  role: "Senior Product Designer",
  location: "Austria and Germany, as well as remote",
  heroHeadline:
    "Product designer turning complex technical systems into clear, usable digital experiences.",
  heroText:
    "I combine technical understanding with UX research, prototyping, and product thinking to design practical digital experiences.",
  aboutHeadline:
    "I design digital products where technical complexity meets human needs.",
  aboutText:
    "My background in IT support, mobile computing, and HCI helps me understand both user pain points and technical constraints. I use research, prototyping, and structured design methods to turn unclear problems into usable product experiences.",
  availability: "Available for UX/Product Design roles in Austria, Germany, and remote.",
  protectedActions: ["Email", "Call", "LinkedIn", "Download CV"]
};

const heroStats = [
  { value: "MSc", label: "Human-Centered Computing" },
  { value: "IT + mobile", label: "Background in support and mobile computing" },
  { value: "UX methods", label: "Research, prototyping, and service design" }
];

const timelineItems = [
  {
    period: "2012 - 2014",
    title: "IT services foundation",
    body: "Supported applications, server operations, and network troubleshooting."
  },
  {
    period: "2016 - 2021",
    title: "Mobile computing and HCI",
    body: "Studied mobile computing and human-centered design at FH Hagenberg."
  },
  {
    period: "2020 - 2021",
    title: "Android product building",
    body: "Designed and developed an Android app for interactive tour experiences."
  },
  {
    period: "2022 - now",
    title: "Senior product design",
    body: "Designing web, Android, and iOS travel products at Invia Group."
  }
];

const toolGroups = [
  {
    title: "Research and validation",
    tools: [
      "User interviews",
      "Surveys",
      "Usability testing",
      "Competitive analysis",
      "Lyssna",
      "MS Clarity",
      "Firebase Analytics"
    ]
  },
  {
    title: "Product design methods",
    tools: [
      "Wireframing",
      "Prototyping",
      "Accessibility patterns",
      "Design Systems",
      "Material Design",
      "Human Interface Guidelines",
      "AI workflows"
    ]
  },
  {
    title: "Platforms and tools",
    tools: [
      "Figma",
      "ProtoPie",
      "Adobe XD",
      "Android and iOS",
      "Jira",
      "Confluence",
      "Miro"
    ]
  }
];

const projectPreviews = [
  {
    title: "Travel booking platform",
    summary:
      "Responsible for UX/UI design across web, Android, and iOS travel booking products with more than 2M downloads, including a full redesign and relaunch of the outdated mobile app experience.",
    role: "Senior Product Design",
    outcome: "Best travel portal app at the German App Award 2026",
    tags: ["Interaction Design", "Mobile UX", "Prototyping"],
    image: "/images/work/ab-in-den-urlaub.jpg",
    imageAlt: "Ab in den Urlaub web and mobile booking screens"
  },
  {
    title: "Online challenge platform",
    summary:
      "Created a mobile-first product structure for creating, sharing, and joining challenges.",
    role: "Product Design, Mobile UX",
    outcome: "Created 3 user flows and 2 prototype iterations",
    tags: ["Service Design", "Mobile UX", "Interaction Design"],
    image: "/images/work/challenge.png",
    imageAlt: "Mobile challenge app screens"
  },
  {
    title: "Interactive tour application",
    summary:
      "Designed an Android tour experience that makes location-based content easier to follow.",
    role: "UX Design, Android Development",
    outcome: "Improved navigation clarity before implementation",
    tags: ["Mobile UX", "Prototyping", "Usability Testing"],
    image: "/images/work/gamification.png",
    imageAlt: "Gamified mobile tour interaction screens"
  },
  {
    title: "Websites for service professionals",
    summary:
      "Created clean, trustworthy websites and digital advice for actors, psychotherapists, and art crafters.",
    role: "UX/UI Design, Web Consulting",
    outcome: "Structured content, visual direction, and launch-ready web presence",
    tags: ["Web Design", "UX Consulting", "Service Design", "Content Structure"],
    visual: "websites"
  }
];

const processAreas = [
  {
    title: "Product diagnosis",
    body: "I clarify the product goal, constraints, target users, and key usability risks before moving into solutions."
  },
  {
    title: "User research",
    body: "I use interviews, desk research, and usability signals to understand user needs and decision points."
  },
  {
    title: "AI-assisted synthesis",
    body: "I use AI to structure research notes, cluster findings, and speed up early synthesis."
  },
  {
    title: "Journey mapping",
    body: "I map the current experience to identify friction, gaps, and opportunities across the user flow."
  },
  {
    title: "Usability testing",
    body: "I test prototypes with users to validate assumptions and improve interaction clarity."
  },
  {
    title: "Handoff",
    body: "I prepare flows, UI states, and implementation notes so designs can move into development."
  }
];

const featuredCaseStudy = {
  title: "Food Delivery Comparison Experience",
  summary:
    "A mobile-first concept for comparing food delivery services by price, delivery time, fees, and usability.",
  proofPoints: ["5 user tests", "4 comparison criteria", "2 prototype iterations"],
  context: "Users often compare delivery options manually across multiple apps.",
  problem:
    "Important decision factors such as fees, delivery time, and availability are hard to compare quickly.",
  process: "Mapped the comparison journey, designed mobile flows, and tested a clickable prototype.",
  outcome: "Improved clarity around restaurant and delivery option comparison.",
  href: "/work/school-of-ux-booking/",
  tags: ["UX Research", "Service Design", "Mobile UX", "Prototyping"]
};
---

<BaseLayout
  title="Laurenz Gebauer | UX Portfolio"
  description="UX and Product Design portfolio for Laurenz Gebauer, focused on research, usability, mobile UX, and technically grounded product design."
  path="/"
>
  <section class="hero-section" data-reveal>
    <div class="hero-content">
      <p class="eyebrow">UX & Product Designer</p>
      <h1>{site.heroHeadline}</h1>
      <p class="hero-lede">{site.heroText}</p>

      <div class="button-row">
        <a href="#work" class="button button-primary">View selected work</a>
        <a href="#contact" class="button button-secondary">Get in touch</a>
        <button type="button" class="button button-secondary" data-unlock-trigger>Download CV</button>
      </div>
    </div>

    <aside class="hero-card">
      <div>
        <span class="hero-card-label">Focus areas</span>
        <p>UX Research &middot; Product Design &middot; Mobile UX &middot; Service Design</p>
      </div>
      <div class="hero-card-meta">
        <span>Available in Austria, Germany & remote</span>
      </div>
    </aside>
  </section>

  <section id="about" class="about-section section-space" data-reveal>
    <div class="profile-photo-frame">
      <img src={profileImage} alt="Portrait of Laurenz Gebauer" class="profile-photo" loading="eager" />
    </div>

    <div class="about-copy">
      <p class="eyebrow">About</p>
      <h2>{site.aboutHeadline}</h2>
      <p>{site.aboutText}</p>

      <div class="stats-grid">
        {heroStats.map((stat) => (
          <article class="stat-card">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="experience-section section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Experience & toolkit</p>
      <h2>Technical background, product design practice, and modern UX tools.</h2>
      <p>
        A compact overview of the path that shaped how I approach product problems: systems first,
        users always, and delivery in mind.
      </p>
    </div>

    <div class="experience-layout">
      <div class="timeline">
        {timelineItems.map((item) => (
          <article class="timeline-item">
            <span>{item.period}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>

      <aside class="tool-panel">
        <p class="eyebrow">Tools and methods</p>
        <div class="tool-groups">
          {toolGroups.map((group) => (
            <section class="tool-group" aria-label={group.title}>
              <h3>{group.title}</h3>
              <div class="tool-cloud">
                {group.tools.map((tool) => <span>{tool}</span>)}
              </div>
            </section>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section id="work" class="work-section section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Selected work</p>
      <h2>Selected UX/Product Design case studies</h2>
      <p>Each project highlights the problem, my role, and design outcomes.</p>
    </div>

    <div class="project-grid">
      {projectPreviews.map((project) => (
        <article class="project-card">
          {project.image ? (
            <div class="project-image-shell">
              <img src={project.image} alt={project.imageAlt} class="project-image" loading="lazy" />
            </div>
          ) : project.visual === "websites" ? (
            <div class="project-image-shell project-visual-websites" aria-hidden="true">
              <div class="website-preview">
                <div class="website-nav">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <div class="website-hero">
                  <strong>Personal brand website</strong>
                  <p>Clear positioning, calm content structure, and confident service presentation.</p>
                </div>
                <div class="website-grid">
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>
          ) : (
            <div class="project-image-shell project-visual-delivery" aria-hidden="true">
              <div class="delivery-phone delivery-phone-left">
                <span>Wolt</span>
                <strong>24 min</strong>
                <small>EUR 15.80 total</small>
              </div>
              <div class="delivery-phone delivery-phone-right">
                <span>Lieferando</span>
                <strong>31 min</strong>
                <small>EUR 13.40 total</small>
              </div>
            </div>
          )}

          <div class="project-body">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <dl class="project-facts">
              <div>
                <dt>Role</dt>
                <dd>{project.role}</dd>
              </div>
              <div>
                <dt>Outcome</dt>
                <dd>{project.outcome}</dd>
              </div>
            </dl>

            <ul class="tag-list" aria-label={`${project.title} tags`}>
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="case-study-preview section-space" data-reveal>
    <div class="featured-case-copy">
      <p class="eyebrow">Featured case study</p>
      <h2>{featuredCaseStudy.title}</h2>
      <p>{featuredCaseStudy.summary}</p>

      <div class="proof-point-grid" aria-label="Featured case study proof points">
        {featuredCaseStudy.proofPoints.map((proof) => <span>{proof}</span>)}
      </div>

      <div class="featured-case-grid">
        <article>
          <span>Context</span>
          <p>{featuredCaseStudy.context}</p>
        </article>
        <article>
          <span>Problem</span>
          <p>{featuredCaseStudy.problem}</p>
        </article>
        <article>
          <span>Process</span>
          <p>{featuredCaseStudy.process}</p>
        </article>
        <article>
          <span>Outcome</span>
          <p>{featuredCaseStudy.outcome}</p>
        </article>
      </div>
    </div>

    <aside class="featured-case-aside">
      <div class="featured-preview" aria-hidden="true">
        <div class="featured-phone">
          <span>Compare</span>
          <strong>Best delivery match</strong>
          <div class="featured-result is-active">
            <small>Wolt</small>
            <b>24 min &middot; EUR 15.80</b>
          </div>
          <div class="featured-result">
            <small>Lieferando</small>
            <b>31 min &middot; EUR 13.40</b>
          </div>
        </div>
      </div>
      <ul class="tag-list" aria-label="Featured case study tags">
        {featuredCaseStudy.tags.map((tag) => <li>{tag}</li>)}
      </ul>

      <a href={featuredCaseStudy.href} class="button button-primary">Read case study</a>
    </aside>
  </section>

  <section id="approach" class="approach-section section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Process</p>
      <h2>A clear UX process from diagnosis to handoff.</h2>
      <p>A practical process for turning unclear product problems into testable design decisions.</p>
    </div>

    <div class="method-grid">
      {processAreas.map((method, index) => (
        <article class="method-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{method.title}</h3>
          <p>{method.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="contact-section section-space" data-reveal>
    <div class="contact-copy">
      <p class="eyebrow">Contact</p>
      <h2>Let's build clear, usable digital products.</h2>
      <p>{site.availability}</p>

      <div class="contact-links" data-contact-actions>
        {site.protectedActions.map((label) => (
          <button type="button" data-unlock-trigger>{label}</button>
        ))}
      </div>
    </div>

    <aside class="contact-profile-card">
      <img src={profileImage} alt="Portrait of Laurenz Gebauer" class="contact-avatar" loading="lazy" />
      <div>
        <h3 data-private-name>Contact details locked</h3>
        <p data-private-details>
          Enter the portfolio password to reveal direct contact details and the CV download.
        </p>
      </div>
    </aside>
  </section>

  <dialog class="unlock-dialog" data-unlock-dialog>
    <form method="dialog" class="unlock-card" data-unlock-form>
      <div>
        <p class="eyebrow">Private contact</p>
        <h2>Unlock contact details</h2>
        <p>
          Please enter the portfolio password to reveal email, phone, LinkedIn, and CV access.
        </p>
      </div>

      <label class="unlock-field">
        <span>Password</span>
        <input type="password" autocomplete="current-password" data-unlock-input />
      </label>

      <p class="unlock-error" data-unlock-error hidden>That password does not match. Please try again.</p>

      <div class="unlock-actions">
        <button type="button" class="button button-primary" data-unlock-submit>Unlock</button>
        <button type="button" class="button button-secondary" data-unlock-close>Cancel</button>
      </div>
    </form>
  </dialog>

  <script is:inline>
    const PRIVATE_CONTACT_PAYLOAD = {
      salt: "Iz4DcHwKOuKYY4P/F8e0sA==",
      iv: "7M5q7yDyfvWXTOK4",
      data:
        ""
    };

    let unlockedContact = null;

    const fromBase64 = (value) => Uint8Array.from(atob(value), (character) => character.charCodeAt(0));

    const decryptPrivateContact = async (password) => {
      const keyMaterial = await crypto.subtle.importKey(
        "raw",
        new TextEncoder().encode(password),
        "PBKDF2",
        false,
        ["deriveKey"]
      );

      const key = await crypto.subtle.deriveKey(
        {
          name: "PBKDF2",
          salt: fromBase64(PRIVATE_CONTACT_PAYLOAD.salt),
          iterations: 150000,
          hash: "SHA-256"
        },
        keyMaterial,
        { name: "AES-GCM", length: 256 },
        false,
        ["decrypt"]
      );

      const decrypted = await crypto.subtle.decrypt(
        { name: "AES-GCM", iv: fromBase64(PRIVATE_CONTACT_PAYLOAD.iv) },
        key,
        fromBase64(PRIVATE_CONTACT_PAYLOAD.data)
      );

      return JSON.parse(new TextDecoder().decode(decrypted));
    };

    const renderPrivateContact = (privateContact = unlockedContact) => {
      if (!privateContact) {
        return;
      }

      const nameTarget = document.querySelector("[data-private-name]");
      const detailTarget = document.querySelector("[data-private-details]");
      const actionsTarget = document.querySelector("[data-contact-actions]");

      if (nameTarget) {
        nameTarget.textContent = privateContact.name;
      }

      if (detailTarget) {
        detailTarget.innerHTML = privateContact.details.join("<br />");
      }

      if (actionsTarget) {
        actionsTarget.innerHTML = "";

        for (const action of privateContact.actions) {
          const link = document.createElement("a");
          link.href = action.href;
          link.textContent = action.label;

          if (action.external) {
            link.target = "_blank";
            link.rel = "noreferrer";
          }

          if (action.download) {
            link.setAttribute("download", "");
          }

          actionsTarget.append(link);
        }
      }
    };

    const dialog = document.querySelector("[data-unlock-dialog]");
    const input = document.querySelector("[data-unlock-input]");
    const error = document.querySelector("[data-unlock-error]");

    const openUnlockDialog = () => {
      if (unlockedContact) {
        renderPrivateContact();
        return;
      }

      if (dialog instanceof HTMLDialogElement) {
        dialog.showModal();
        input?.focus();
      }
    };

    const unlockContact = async () => {
      const value = input?.value ?? "";
      try {
        unlockedContact = await decryptPrivateContact(value);
      } catch {
        if (error) {
          error.hidden = false;
        }
        return;
      }

      renderPrivateContact();
      dialog?.close();
    };

    document.querySelectorAll("[data-unlock-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", openUnlockDialog);
    });

    document.querySelector("[data-unlock-submit]")?.addEventListener("click", unlockContact);
    document.querySelector("[data-unlock-close]")?.addEventListener("click", () => dialog?.close());
    document.querySelector("[data-unlock-form]")?.addEventListener("submit", (event) => {
      event.preventDefault();
      unlockContact();
    });

    dialog?.addEventListener("close", () => {
      if (input) {
        input.value = "";
      }
      if (error) {
        error.hidden = true;
      }
    });
  </script>
</BaseLayout>
