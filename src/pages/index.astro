---
import BaseLayout from "../layouts/BaseLayout.astro";

const profileImage = "/images/profile-laurenz.jpg";
const cvHref = "/Laurenz_Gebauer_CV.pdf";

const site = {
  name: "Laurenz Gebauer",
  role: "Senior Product Designer",
  location: "Austria and Germany, as well as remote",
  heroHeadline:
    "Product designer turning complex technical systems into clear, usable digital experiences.",
  heroText:
    "I combine technical understanding with UX research, prototyping, and product thinking to design practical digital experiences.",
  aboutHeadline:
    "I design digital products where technical complexity meets human needs.",
  aboutText:
    "My background in IT support, mobile computing, and HCI helps me understand both user pain points and technical constraints. I use research, prototyping, and structured design methods to turn unclear problems into usable product experiences.",
  availability: "Available for UX/Product Design roles in Austria, Germany, and remote.",
  contactLinks: [
    { label: "Email", href: "mailto:laurenz.gebauer@gmx.at" },
    { label: "Call", href: "tel:+436606422328" },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/laurenz-gebauer/" },
    { label: "Download CV", href: cvHref, download: true }
  ]
};

const heroStats = [
  { value: "MSc", label: "Human-Centered Computing" },
  { value: "IT + mobile", label: "Background in support and mobile computing" },
  { value: "UX methods", label: "Research, prototyping, and service design" }
];

const trustSignals = [
  "MSc Human-Centered Computing",
  "Background in IT support and mobile computing",
  "UX research, prototyping, and service design",
  "Available in Austria, Germany, and remote"
];

const timelineItems = [
  {
    period: "2012 - 2014",
    title: "IT services foundation",
    body: "Application support, server operations, and network support."
  },
  {
    period: "2016 - 2021",
    title: "Mobile computing and HCI",
    body: "BSc Mobile Computing and MSc Human-Centered Computing at FH Hagenberg."
  },
  {
    period: "2020 - 2021",
    title: "Android product building",
    body: "Designed and developed an Android app for interactive tours."
  },
  {
    period: "2022 - now",
    title: "Senior product design",
    body: "UX/UI for web, Android, and iOS travel products at Invia Group."
  }
];

const toolGroups = [
  "Figma",
  "ProtoPie",
  "Android",
  "Material Design",
  "Human Interface Guidelines",
  "Design Systems",
  "MS Clarity",
  "Firebase Analytics",
  "Jira",
  "Confluence",
  "Miro",
  "AI workflows"
];

const projectPreviews = [
  {
    title: "Travel booking platform",
    summary:
      "Redesigned a travel booking flow to reduce decision overload across web and mobile.",
    role: "UX Research, UI Design",
    methods: "Journey mapping, wireframes, prototype",
    outcome: "Identified 7 usability issues in testing",
    tags: ["Interaction Design", "Mobile UX", "Prototyping"],
    image: "/images/work/project-ecommerce-web.jpg",
    imageAlt: "Travel booking platform screens across web and mobile"
  },
  {
    title: "Online challenge platform",
    summary:
      "Created a mobile-first product structure for creating, sharing, and joining challenges.",
    role: "Product Design, Mobile UX",
    methods: "User flows, wireframes, prototype",
    outcome: "Created 3 user flows and 2 prototype iterations",
    tags: ["Service Design", "Mobile UX", "Interaction Design"],
    image: "/images/work/project-lean.jpg",
    imageAlt: "Mobile challenge app screens"
  },
  {
    title: "Interactive tour application",
    summary:
      "Designed an Android tour experience that makes location-based content easier to follow.",
    role: "UX Design, Android Development",
    methods: "Prototype, usability review, mobile UI",
    outcome: "Improved navigation clarity before implementation",
    tags: ["Mobile UX", "Prototyping", "Usability Testing"],
    image: "/images/work/project-gamification.jpg",
    imageAlt: "Gamified mobile tour interaction screens"
  },
  {
    title: "Food delivery comparison",
    summary:
      "Explored a comparison experience for delivery options across multiple providers.",
    role: "UX Research, Service Design",
    methods: "Journey mapping, prototype, user testing",
    outcome: "Tested with 5 users for comparison clarity",
    tags: ["UX Research", "Service Design", "Mobile UX", "Usability Testing"],
    visual: "delivery"
  }
];

const processAreas = [
  {
    title: "Product diagnosis",
    body: "I clarify the product goal, constraints, target users, and key usability risks before moving into solutions."
  },
  {
    title: "User research",
    body: "I use interviews, desk research, and usability signals to understand user needs and decision points."
  },
  {
    title: "AI-assisted synthesis",
    body: "I use AI to structure research notes, cluster findings, and speed up early synthesis."
  },
  {
    title: "Journey mapping",
    body: "I map the current experience to identify friction, gaps, and opportunities across the user flow."
  },
  {
    title: "Usability testing",
    body: "I test prototypes with users to validate assumptions and improve interaction clarity."
  },
  {
    title: "Handoff",
    body: "I prepare flows, UI states, and implementation notes so designs can move into development."
  }
];

const featuredCaseStudy = {
  title: "Food Delivery Comparison Experience",
  summary:
    "A mobile-first concept for comparing food delivery services by price, delivery time, fees, and usability.",
  proofPoints: ["5 user tests", "4 comparison criteria", "2 prototype iterations"],
  context: "Users often compare delivery options manually across multiple apps.",
  problem:
    "Important decision factors such as fees, delivery time, and availability are hard to compare quickly.",
  process: "Mapped the comparison journey, designed mobile flows, and tested a clickable prototype.",
  outcome: "Improved clarity around restaurant and delivery option comparison.",
  href: "/work/school-of-ux-booking/",
  tags: ["UX Research", "Service Design", "Mobile UX", "Prototyping"]
};
---

<BaseLayout
  title="Laurenz Gebauer | UX Portfolio"
  description="UX and Product Design portfolio for Laurenz Gebauer, focused on research, usability, mobile UX, and technically grounded product design."
  path="/"
>
  <section class="hero-section" data-reveal>
    <div class="hero-content">
      <p class="eyebrow">UX & Product Designer</p>
      <h1>{site.heroHeadline}</h1>
      <p class="hero-lede">{site.heroText}</p>

      <div class="button-row">
        <a href="#work" class="button button-primary">View selected work</a>
        <a href="#contact" class="button button-secondary">Get in touch</a>
        <a href={cvHref} class="button button-secondary" download>Download CV</a>
      </div>
    </div>

    <aside class="hero-card">
      <div>
        <span class="hero-card-label">Focus areas</span>
        <p>UX Research &middot; Product Design &middot; Mobile UX &middot; Service Design</p>
      </div>
      <div class="hero-card-meta">
        <span>Available in Austria, Germany & remote</span>
      </div>
    </aside>
  </section>

  <section class="trust-strip" aria-label="Trust signals" data-reveal>
    {trustSignals.map((signal) => <span>{signal}</span>)}
  </section>

  <section id="about" class="about-section section-space" data-reveal>
    <div class="profile-photo-frame">
      <img src={profileImage} alt="Portrait of Laurenz Gebauer" class="profile-photo" loading="eager" />
    </div>

    <div class="about-copy">
      <p class="eyebrow">About</p>
      <h2>{site.aboutHeadline}</h2>
      <p>{site.aboutText}</p>

      <div class="stats-grid">
        {heroStats.map((stat) => (
          <article class="stat-card">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="experience-section section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Experience & toolkit</p>
      <h2>Technical background, product design practice, and modern UX tools.</h2>
      <p>
        A compact overview of the path that shaped how I approach product problems: systems first,
        users always, and delivery in mind.
      </p>
    </div>

    <div class="experience-layout">
      <div class="timeline">
        {timelineItems.map((item) => (
          <article class="timeline-item">
            <span>{item.period}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>

      <aside class="tool-panel">
        <p class="eyebrow">Tools and methods</p>
        <div class="tool-cloud">
          {toolGroups.map((tool) => <span>{tool}</span>)}
        </div>
      </aside>
    </div>
  </section>

  <section id="work" class="work-section section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Selected work</p>
      <h2>Selected UX/Product Design case studies</h2>
      <p>Each project highlights the problem, my role, methods, and design outcomes.</p>
    </div>

    <div class="project-grid">
      {projectPreviews.map((project) => (
        <article class="project-card">
          {project.image ? (
            <div class="project-image-shell">
              <span class="preview-label">Case preview</span>
              <img src={project.image} alt={project.imageAlt} class="project-image" loading="lazy" />
            </div>
          ) : (
            <div class="project-image-shell project-visual-delivery" aria-hidden="true">
              <span class="preview-label">Case preview</span>
              <div class="delivery-phone delivery-phone-left">
                <span>Wolt</span>
                <strong>24 min</strong>
                <small>EUR 15.80 total</small>
              </div>
              <div class="delivery-phone delivery-phone-right">
                <span>Lieferando</span>
                <strong>31 min</strong>
                <small>EUR 13.40 total</small>
              </div>
            </div>
          )}

          <div class="project-body">
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <dl class="project-facts">
              <div>
                <dt>Role</dt>
                <dd>{project.role}</dd>
              </div>
              <div>
                <dt>Methods</dt>
                <dd>{project.methods}</dd>
              </div>
              <div>
                <dt>Outcome</dt>
                <dd>{project.outcome}</dd>
              </div>
            </dl>

            <ul class="tag-list" aria-label={`${project.title} tags`}>
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="case-study-preview section-space" data-reveal>
    <div class="featured-case-copy">
      <p class="eyebrow">Featured case study</p>
      <h2>{featuredCaseStudy.title}</h2>
      <p>{featuredCaseStudy.summary}</p>

      <div class="proof-point-grid" aria-label="Featured case study proof points">
        {featuredCaseStudy.proofPoints.map((proof) => <span>{proof}</span>)}
      </div>

      <div class="featured-case-grid">
        <article>
          <span>Context</span>
          <p>{featuredCaseStudy.context}</p>
        </article>
        <article>
          <span>Problem</span>
          <p>{featuredCaseStudy.problem}</p>
        </article>
        <article>
          <span>Process</span>
          <p>{featuredCaseStudy.process}</p>
        </article>
        <article>
          <span>Outcome</span>
          <p>{featuredCaseStudy.outcome}</p>
        </article>
      </div>
    </div>

    <aside class="featured-case-aside">
      <div class="featured-preview" aria-hidden="true">
        <div class="featured-phone">
          <span>Compare</span>
          <strong>Best delivery match</strong>
          <div class="featured-result is-active">
            <small>Wolt</small>
            <b>24 min &middot; EUR 15.80</b>
          </div>
          <div class="featured-result">
            <small>Lieferando</small>
            <b>31 min &middot; EUR 13.40</b>
          </div>
        </div>
      </div>
      <ul class="tag-list" aria-label="Featured case study tags">
        {featuredCaseStudy.tags.map((tag) => <li>{tag}</li>)}
      </ul>

      <a href={featuredCaseStudy.href} class="button button-primary">Read case study</a>
    </aside>
  </section>

  <section id="approach" class="approach-section section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Process</p>
      <h2>A clear UX process from diagnosis to handoff.</h2>
      <p>A practical process for turning unclear product problems into testable design decisions.</p>
    </div>

    <div class="method-grid">
      {processAreas.map((method, index) => (
        <article class="method-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{method.title}</h3>
          <p>{method.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="contact-section section-space" data-reveal>
    <div class="contact-copy">
      <p class="eyebrow">Contact</p>
      <h2>Let's build clear, usable digital products.</h2>
      <p>{site.availability}</p>

      <div class="contact-links">
        {site.contactLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            download={link.download}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <aside class="contact-profile-card">
      <img src={profileImage} alt="Portrait of Laurenz Gebauer" class="contact-avatar" loading="lazy" />
      <div>
        <h3>Laurenz Gebauer</h3>
        <p>
          Senior Product Designer<br />
          +43 660 642 2328<br />
          laurenz.gebauer@gmx.at
        </p>
      </div>
    </aside>
  </section>
</BaseLayout>
