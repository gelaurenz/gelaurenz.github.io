---
import BaseLayout from "../layouts/BaseLayout.astro";

const site = {
  name: "Laurenz Gebauer",
  role: "UX & Product Designer",
  location: "Austria",
  summary:
    "UX designer, researcher, and prototype engineer shaping intuitive digital products for large-scale platforms and emerging experiences.",
  intro:
    "I hold a Master of Science in Human-Centered Computing from the University of Applied Sciences Hagenberg. I have been designing engaging and intuitive interfaces for products that delight millions of customers, always looking for better clarity, stronger usability, and more thoughtful interaction design.",
  mission:
    "My aim is to create products that not only function well but also bring joy and inspiration. I am especially motivated by the intersection of technology, design, travel, and human insight.",
  availability:
    "Open to UX design, product design, research, and prototyping collaborations.",
  contactLinks: [
    {
      label: "Email",
      href: "mailto:laurenz.gebauer@gmx.at"
    },
    {
      label: "Call",
      href: "tel:+436606422328"
    },
    {
      label: "GitHub",
      href: "https://github.com/gelaurenz"
    },
    {
      label: "Figma Portfolio",
      href: "https://www.figma.com/design/M1Gy1R4VKp6XwEXmrMCcYI/Gebauer-L.--Portfolio?node-id=328-22996&t=Nkl4n2Rei7qcDgh8-1"
    }
  ],
  profileHighlights: [
    "UX & Product Designer",
    "Researcher",
    "Prototype Engineer"
  ],
  aboutParagraphs: [
    "I bring usability, creativity, and teamwork into every project, always looking for ways to increase product maturity and make experiences easier to understand. I enjoy turning complexity into structure and helping products feel calm, clear, and complete.",
    "In this portfolio, you will find examples of product work, research methods, validation tools, and delivery practices that I use to strengthen UX maturity inside companies and ensure more exceptional user experiences."
  ]
};

const heroFacts = [
  { label: "Education", value: "MSc Human-Centered Computing" },
  { label: "Focus", value: "Research, product design, prototype engineering" },
  { label: "Base", value: "Austria" },
  { label: "Scale", value: "Platforms with 2M+ downloads" }
];

const heroSignals = [
  "Large-scale commerce and mobile UX",
  "Research, validation, and prototyping",
  "Accessibility, testing, and handover thinking"
];

const projectPreviews = [
  {
    eyebrow: "E-Commerce",
    title: "Travel portal, mobile booking, and offer discovery",
    description:
      "Responsible for designing a web portal and associated Android and iOS apps with more than 2 million downloads.",
    tags: ["Web portal", "Android + iOS", "2M+ downloads"],
    image: "/images/work/case-marketplace.png",
    imageAlt: "Travel booking product shown across mobile and web interfaces",
    art: "commerce"
  },
  {
    eyebrow: "Lean Design",
    title: "Challenge creation and participation platform",
    description:
      "Led the development of an online platform facilitating the creation, sharing, and participation in online challenges.",
    tags: ["Challenge flows", "Mobile-first", "Content systems"],
    art: "lean"
  },
  {
    eyebrow: "Gamification",
    title: "Interactive tour application for Android",
    description:
      "Developed and designed a mobile application for interactive tours on Android platforms with a more playful exploration model.",
    tags: ["Android", "Gamified UX", "Interactive tours"],
    art: "game"
  }
];

const processAreas = [
  {
    eyebrow: "UI",
    title: "Design review",
    body:
      "I review current products to evaluate what works, what does not, and where assumptions deserve to be challenged from a product and usability perspective."
  },
  {
    eyebrow: "Research",
    title: "User research",
    body:
      "I use personas, surveys, and audience profiling to understand who the product is for, how current behavior looks, and which business hypotheses should be validated next."
  },
  {
    eyebrow: "User experience",
    title: "User journey",
    body:
      "I map journeys to understand how many steps users need to complete important tasks, where they hesitate, and where the experience can be simplified or optimized."
  },
  {
    eyebrow: "User experience",
    title: "Accessibility",
    body:
      "I treat accessibility and performance as part of product quality by checking content integrity, keyboard support, screen-size resilience, and key WCAG expectations."
  }
];

const validationMethods = [
  {
    eyebrow: "User experience",
    title: "Qualitative usability testing",
    body:
      "I run remote and in-house usability studies to validate design assumptions, capture real behavior, and translate observations into concrete product improvements."
  },
  {
    eyebrow: "User experience",
    title: "Heuristic evaluation",
    body:
      "I use heuristic reviews to surface experience issues early, give teams a shared quality lens, and prioritize where the interface needs the most improvement."
  },
  {
    eyebrow: "User experience",
    title: "Attitudinal metrics",
    body:
      "Depending on project goals, I use SUS, SUPR-Q, CSAT, SEQ, UMUX, SMEQ, Net Promoter Score, and customer feedback to quantify user perception."
  },
  {
    eyebrow: "User experience",
    title: "Prototyping",
    body:
      "I create prototypes of varying fidelity to capture concepts, test them early, and refine requirements before release. My workflow regularly includes Figma and ProtoPie."
  },
  {
    eyebrow: "UI",
    title: "Design handover",
    body:
      "I prepare handovers with user journeys, sitemap logic, content copy, component states, loading and error states, and implementation-ready detail for developers."
  }
];

const currentCaseStudy = {
  title: "Booking Experience Case Study",
  eyebrow: "Featured case study",
  summary:
    "A product story built from the original portfolio deck, now reframed for the web around research, journey clarity, accessibility, validation, and handover.",
  tags: ["Research", "Journey mapping", "Accessibility", "Testing", "Handover"],
  href: "/work/school-of-ux-booking/"
};

const contactImage =
  "data:image/jpeg;base64,";

const profileSpotlight = {
  title: "A calmer, more editorial portfolio built from real process work.",
  body:
    "Instead of repeating the old slide layout, this version pulls the strongest content into a cleaner web experience with better pacing, more hierarchy, and clearer proof of how you work.",
  snapshot: [
    { label: "Current focus", value: "UX strategy, product design, research, prototyping" },
    { label: "Best fit", value: "Teams that want strong UX structure and sharper product quality" },
    { label: "Strength", value: "End-to-end flow from review and research to delivery" }
  ]
};

const impactPreview = [
  { value: "2M+", label: "Downloads referenced in the commerce work" },
  { value: "8", label: "Core phases now integrated from the earlier portfolio deck" },
  { value: "5", label: "Validation and delivery methods visible on the homepage" }
];

const visualHighlights = [
  {
    eyebrow: "Research",
    title: "From personas to preference testing",
    body:
      "The older portfolio already contained customer profiling, survey insights, and test variations. They now live inside a more structured, easier-to-skim narrative."
  },
  {
    eyebrow: "Experience",
    title: "From journey mapping to accessibility",
    body:
      "Key experience layers such as journey clarity, unhappy paths, WCAG validation, and performance are now grouped as part of a modern product-quality story."
  },
  {
    eyebrow: "Delivery",
    title: "From testing to implementation readiness",
    body:
      "Usability testing, heuristic evaluation, attitudinal metrics, prototyping, and handover are all shown as part of how you move ideas into shipped products."
  }
];

---

<BaseLayout
  title="Laurenz Gebauer | UX Portfolio"
  description="Responsive UX portfolio for Laurenz Gebauer featuring product thinking, research, prototyping, and case-study storytelling."
  path="/"
>
  <section class="hero-grid hero-grid-signature panel" data-reveal>
    <div class="hero-stage">
      <p class="hero-stage-kicker">Available for product design roles</p>
      <div class="hero-stage-badge">LG</div>
      <h2 class="hero-stage-heading">
        Research-driven design for products that need clarity, confidence, and momentum.
      </h2>
      <p class="hero-stage-copy">
        From large-scale commerce to lean digital products, I design interfaces that translate
        complexity into experiences people can actually use.
      </p>

      <ul class="hero-stage-signals" aria-label="Key strengths">
        {heroSignals.map((signal) => <li>{signal}</li>)}
      </ul>

      <div class="hero-stage-foot">
        <span>{site.location}</span>
        <span>{site.role}</span>
      </div>
    </div>

    <div class="hero-copy">
      <p class="eyebrow">UX portfolio</p>
      <h1>
        Hi, I&apos;m <span>{site.name}</span>
      </h1>
      <p class="lede">{site.summary}</p>
      <p class="supporting-copy">{site.intro}</p>
      <p class="supporting-copy">{site.mission}</p>

      <div class="button-row">
        <a href="#work" class="button button-primary">See selected work</a>
        <a href="#contact" class="button button-secondary">Hire me</a>
      </div>

      <ul class="hero-meta" aria-label="Portfolio details">
        <li>{site.role}</li>
        <li>{site.location}</li>
        <li>{site.availability}</li>
      </ul>

      <ul class="hero-meta hero-meta-roles" aria-label="Discipline highlights">
        {site.profileHighlights.map((item) => <li>{item}</li>)}
      </ul>

      <div class="hero-facts-grid">
        {heroFacts.map((fact) => (
          <article class="hero-fact-card">
            <span>{fact.label}</span>
            <p>{fact.value}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="profile-showcase panel section-space" data-reveal>
    <div class="profile-showcase-media">
      <div class="profile-photo-frame">
        <img src={contactImage} alt="Portrait of Laurenz Gebauer" class="profile-photo" loading="eager" />
      </div>

      <article class="profile-note-card">
        <p class="eyebrow">About</p>
        <h3>{profileSpotlight.title}</h3>
        <p>{profileSpotlight.body}</p>
      </article>
    </div>

    <div class="profile-showcase-copy">
      <p class="eyebrow">Designer snapshot</p>
      <h2>Designing digital products that combine usability, clarity, and joy.</h2>
      {site.aboutParagraphs.map((paragraph) => (
        <p class="supporting-copy">{paragraph}</p>
      ))}

      <div class="profile-snapshot-grid">
        {profileSpotlight.snapshot.map((item) => (
          <article class="profile-snapshot-card">
            <span>{item.label}</span>
            <p>{item.value}</p>
          </article>
        ))}
      </div>

      <div class="impact-strip">
        {impactPreview.map((item) => (
          <article class="impact-card">
            <strong>{item.value}</strong>
            <p>{item.label}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="work" class="panel section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Projects</p>
      <h2>Selected work across commerce, challenge systems, and gamified mobile experiences.</h2>
      <p>
        The previews below are adapted from the previous portfolio and translated into a cleaner
        web format. They show the breadth of the work while keeping the presentation minimal and
        easier to scan.
      </p>
    </div>

    <div class="project-grid project-grid-featured">
      {projectPreviews.map((project) => (
        <article class="project-card project-card-preview">
          {project.image ? (
            <div class="project-image-shell">
              <img src={project.image} alt={project.imageAlt ?? ""} class="project-image" loading="lazy" />
            </div>
          ) : (
            <div class={`project-image-shell project-poster project-poster-${project.art}`}>
              <div class="project-poster-stack">
                <span></span>
                <span></span>
                <span></span>
              </div>
            </div>
          )}

          <div class="project-body">
            <p class="eyebrow">{project.eyebrow}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>

            <ul class="tag-list" aria-label={`${project.title} tags`}>
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>

            <span class="text-link muted-label">Preview from the previous portfolio</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="approach" class="panel section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Approach</p>
      <h2>From design review to accessibility, the product process is visible instead of hidden.</h2>
    </div>

    <div class="principles-grid process-grid">
      {processAreas.map((method, index) => (
        <article class="principle-card method-card story-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <p class="eyebrow eyebrow-inline">{method.eyebrow}</p>
          <h3>{method.title}</h3>
          <p>{method.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="panel section-space highlight-band" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Integrated content</p>
      <h2>The strongest ideas from the old portfolio are now grouped into a cleaner web narrative.</h2>
      <p>
        Instead of forcing visitors through deck slides, the site now highlights the most relevant
        parts of the work in a calmer, more modern structure.
      </p>
    </div>

    <div class="highlight-grid">
      {visualHighlights.map((item) => (
        <article class="highlight-card">
          <p class="eyebrow eyebrow-inline">{item.eyebrow}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="panel section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Validation and delivery</p>
      <h2>Testing, prototyping, and handover are shown as part of the product craft.</h2>
      <p>
        The previous portfolio already had strong evidence of how you validate and deliver work.
        This section makes that explicit so the site feels more credible and complete.
      </p>
    </div>

    <div class="principles-grid delivery-grid">
      {validationMethods.map((method, index) => (
        <article class={`principle-card method-card ${index === validationMethods.length - 1 ? "method-card-accent" : "story-card"}`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <p class="eyebrow eyebrow-inline">{method.eyebrow}</p>
          <h3>{method.title}</h3>
          <p>{method.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="panel case-study-preview section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">{currentCaseStudy.eyebrow}</p>
      <h2>{currentCaseStudy.title}</h2>
      <p>{currentCaseStudy.summary}</p>
    </div>

    <div class="current-case-study">
      <ul class="tag-list" aria-label="Current case study tags">
        {currentCaseStudy.tags.map((tag) => <li>{tag}</li>)}
      </ul>

      <a href={currentCaseStudy.href} class="button button-primary">
        Read the detailed case study
      </a>
    </div>
  </section>

  <section id="contact" class="panel contact-panel section-space" data-reveal>
    <div class="contact-copy">
      <p class="eyebrow">Contact</p>
      <h2>Hire me.</h2>
      <p>
        An experience designer with a dream to use the power of human insight and interactions to
        spark the full creative potential of every project I am involved in.
      </p>

      <div class="contact-links">
        {site.contactLinks.map((link) => (
          <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
            {link.label}
          </a>
        ))}
      </div>

      <p class="contact-signoff">
        Gebauer Laurenz
        <br />
        UX- & Product Designer
        <br />
        +43 660 642 232 8
        <br />
        laurenz.gebauer@gmx.at
      </p>
    </div>

    <aside class="contact-profile-card">
      <div class="contact-avatar-shell">
        <img src={contactImage} alt="Portrait of Laurenz Gebauer" class="contact-avatar" loading="lazy" />
      </div>
      <p class="eyebrow eyebrow-inline">Profile card</p>
      <h3>Open to thoughtful product teams.</h3>
      <p>
        Available for UX, product design, research, and prototyping roles across digital products,
        services, and interface-heavy experiences.
      </p>
    </aside>
  </section>
</BaseLayout>
