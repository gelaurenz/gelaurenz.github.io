---
import BaseLayout from "../layouts/BaseLayout.astro";

const profileImage = "/images/profile-laurenz.jpg";

const site = {
  name: "Laurenz Gebauer",
  role: "Senior Product Designer",
  location: "Austria",
  summary:
    "I combine years of IT, mobile development, and UX research with AI-assisted workflows to turn complex product problems into faster, clearer outcomes.",
  intro:
    "Senior Product Designer at Invia Group, working across web, Android, and iOS products used by millions of customers.",
  mission:
    "My goal is to build digital products that are easy to understand, technically realistic, and strong enough to move from research into production without losing quality.",
  contactLinks: [
    { label: "Email", href: "mailto:laurenz.gebauer@gmx.at" },
    { label: "Call", href: "tel:+436606422328" },
    { label: "GitHub", href: "https://github.com/gelaurenz" },
    {
      label: "Figma portfolio",
      href: "https://www.figma.com/design/M1Gy1R4VKp6XwEXmrMCcYI/Gebauer-L.--Portfolio?node-id=328-22996&t=Nkl4n2Rei7qcDgh8-1"
    }
  ]
};

const heroStats = [
  { value: "2M+", label: "downloads across commerce apps" },
  { value: "10+", label: "years across IT, mobile, and product" },
  { value: "MSc", label: "Human-Centered Computing" }
];

const timelineItems = [
  {
    period: "2012 - 2014",
    title: "IT services foundation",
    body: "Application support, server operations, and network support at Atos IT Solutions and Raiffeisen Informatik."
  },
  {
    period: "2016 - 2021",
    title: "Mobile computing and HCI",
    body: "BSc Mobile Computing and MSc Human-Centered Computing at FH Hagenberg, including research on IoT tracking and interactive mobile tours."
  },
  {
    period: "2020 - 2021",
    title: "Android product building",
    body: "Designed and developed Raccoon Adventures, an Android app for interactive tours and gamified discovery."
  },
  {
    period: "2022 - now",
    title: "Senior product design",
    body: "UX/UI design for web, Android, and iOS travel products at Invia Group, including research, prototyping, testing, and handover."
  }
];

const toolGroups = [
  "Figma",
  "ProtoPie",
  "Android",
  "Material Design",
  "Human Interface Guidelines",
  "Design Systems",
  "MS Clarity",
  "Firebase Analytics",
  "Jira",
  "Confluence",
  "Miro",
  "AI workflows"
];

const projectPreviews = [
  {
    eyebrow: "E-Commerce",
    title: "Travel booking platform",
    description:
      "Designed web, Android, and iOS booking experiences for a travel product with more than 2 million downloads.",
    tags: ["Web", "Android", "iOS"],
    image: "/images/work/project-ecommerce-web.jpg",
    imageAlt: "Travel booking platform screens across web and mobile"
  },
  {
    eyebrow: "Lean Design",
    title: "Online challenge platform",
    description:
      "Led the design of a mobile-first product for creating, sharing, and participating in online challenges.",
    tags: ["Challenge flows", "Mobile app", "Content system"],
    image: "/images/work/project-lean.jpg",
    imageAlt: "Mobile challenge app screens"
  },
  {
    eyebrow: "Gamification",
    title: "Interactive tour application",
    description:
      "Designed and prototyped an Android tour app with playful discovery, map-based content, and gamified progression.",
    tags: ["Android", "Gamified UX", "Tours"],
    image: "/images/work/project-gamification.jpg",
    imageAlt: "Gamified mobile tour interaction screens"
  },
  {
    eyebrow: "Concept case study",
    title: "Food delivery comparison",
    description:
      "A polished product concept for comparing Wolt, Lieferando, and local providers by delivery time, total cost, availability, and trust signals.",
    tags: ["AI workflow", "Mobile UX", "Decision support"],
    visual: "delivery"
  }
];

const processAreas = [
  {
    title: "Product diagnosis",
    body:
      "I evaluate flows, business assumptions, technical constraints, analytics signals, and user friction before jumping into redesign."
  },
  {
    title: "User research",
    body:
      "I use personas, surveys, preference tests, and customer signals to understand the audience behind the product."
  },
  {
    title: "AI-assisted synthesis",
    body:
      "I use AI to structure research notes, compare patterns, accelerate documentation, and create clearer decision material for teams."
  },
  {
    title: "Journey mapping",
    body:
      "I map happy paths, unhappy paths, error states, and decision moments so teams can improve the full experience."
  },
  {
    title: "Usability testing",
    body:
      "I validate concepts with qualitative testing, heuristic reviews, SUS, CSAT, SEQ, UMUX, and user feedback."
  },
  {
    title: "Handover",
    body:
      "I prepare states, flows, content, and implementation detail so design decisions survive the move into development."
  }
];

const currentCaseStudy = {
  title: "Food Delivery Comparison Experience",
  summary:
    "A concept case study showing how AI-supported UX can help customers compare food delivery providers faster, with fewer checkout surprises.",
  tags: ["Concept", "Mobile UX", "AI workflow", "Service design"],
  href: "/work/school-of-ux-booking/"
};
---

<BaseLayout
  title="Laurenz Gebauer | UX Portfolio"
  description="UX portfolio for Laurenz Gebauer featuring product design, user research, prototyping, and case-study storytelling."
  path="/"
>
  <section class="hero-section" data-reveal>
    <div class="hero-content">
      <p class="eyebrow">UX, mobile, and AI-minded product design</p>
      <h1>{site.name}</h1>
      <p class="hero-lede">{site.summary}</p>
      <p class="supporting-copy">{site.intro}</p>

      <div class="button-row">
        <a href="#work" class="button button-primary">View selected work</a>
        <a href="#contact" class="button button-secondary">Get in touch</a>
      </div>
    </div>

    <aside class="hero-card">
      <p>Research, design, prototyping, and AI-enabled delivery for products that need clarity before they scale.</p>
      <div class="hero-card-meta">
        <span>{site.location}</span>
        <span>{site.role}</span>
      </div>
    </aside>
  </section>

  <section id="about" class="about-section section-space" data-reveal>
    <div class="profile-photo-frame">
      <img src={profileImage} alt="Portrait of Laurenz Gebauer" class="profile-photo" loading="eager" />
    </div>

    <div class="about-copy">
      <p class="eyebrow">About</p>
      <h2>Designing products with a technical backbone and a human-centered lens.</h2>
      <p>{site.mission}</p>
      <p>
        My background spans IT infrastructure, mobile development, UX research, product design,
        prototyping, and developer handover. That mix helps me connect strategy, design quality,
        and implementation reality instead of treating them as separate worlds.
      </p>

      <div class="stats-grid">
        {heroStats.map((stat) => (
          <article class="stat-card">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="experience-section section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Experience system</p>
      <h2>From IT support to senior product design.</h2>
      <p>
        The story is not only visual design. It is a progression from technical systems and mobile
        development into UX, research, and AI-supported product delivery.
      </p>
    </div>

    <div class="experience-layout">
      <div class="timeline">
        {timelineItems.map((item) => (
          <article class="timeline-item">
            <span>{item.period}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>

      <aside class="tool-panel">
        <p class="eyebrow">Tools and methods</p>
        <div class="tool-cloud">
          {toolGroups.map((tool) => <span>{tool}</span>)}
        </div>
      </aside>
    </div>
  </section>

  <section id="work" class="work-section section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Selected work</p>
      <h2>Product work across commerce, challenge systems, and mobile experiences.</h2>
      <p>
        A compact overview of projects from the previous portfolio, now presented with a cleaner
        structure and stronger visuals.
      </p>
    </div>

    <div class="project-grid project-grid-featured">
      {projectPreviews.map((project) => (
        <article class="project-card">
          {project.image ? (
            <div class="project-image-shell">
              <img src={project.image} alt={project.imageAlt} class="project-image" loading="lazy" />
            </div>
          ) : (
            <div class="project-image-shell project-visual-delivery" aria-hidden="true">
              <div class="delivery-phone delivery-phone-left">
                <span>Wolt</span>
                <strong>24 min</strong>
                <small>EUR 15.80 total</small>
              </div>
              <div class="delivery-phone delivery-phone-right">
                <span>Lieferando</span>
                <strong>31 min</strong>
                <small>EUR 13.40 total</small>
              </div>
            </div>
          )}

          <div class="project-body">
            <p class="eyebrow eyebrow-inline">{project.eyebrow}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>

            <ul class="tag-list" aria-label={`${project.title} tags`}>
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="approach" class="approach-section section-space" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Process</p>
      <h2>A practical UX process from diagnosis to delivery.</h2>
      <p>
        The portfolio now focuses on the methods that matter most for hiring: how I understand
        problems, validate decisions, and prepare work for implementation.
      </p>
    </div>

    <div class="method-grid">
      {processAreas.map((method, index) => (
        <article class="method-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{method.title}</h3>
          <p>{method.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="case-study-preview section-space" data-reveal>
    <div>
      <p class="eyebrow">Featured case study</p>
      <h2>{currentCaseStudy.title}</h2>
      <p>{currentCaseStudy.summary}</p>
    </div>

    <div class="case-study-actions">
      <div class="mini-comparison" aria-hidden="true">
        <span class="mini-dot"></span>
        <strong>Best match</strong>
        <p>Lower fee, faster ETA, available now</p>
      </div>
      <ul class="tag-list" aria-label="Current case study tags">
        {currentCaseStudy.tags.map((tag) => <li>{tag}</li>)}
      </ul>

      <a href={currentCaseStudy.href} class="button button-primary">
        Read case study
      </a>
    </div>
  </section>

  <section id="contact" class="contact-section section-space" data-reveal>
    <div class="contact-copy">
      <p class="eyebrow">Contact</p>
      <h2>Hire me.</h2>
      <p>
        An experience designer using human insight, structure, and interaction design to help
        product teams build better digital experiences.
      </p>

      <div class="contact-links">
        {site.contactLinks.map((link) => (
          <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <aside class="contact-profile-card">
      <img src={profileImage} alt="Portrait of Laurenz Gebauer" class="contact-avatar" loading="lazy" />
      <div>
        <h3>Laurenz Gebauer</h3>
        <p>
          UX & Product Designer<br />
          +43 660 642 232 8<br />
          laurenz.gebauer@gmx.at
        </p>
      </div>
    </aside>
  </section>
</BaseLayout>
