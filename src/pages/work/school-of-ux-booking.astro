---
import BaseLayout from "../../layouts/BaseLayout.astro";

const study = {
  title: "Booking Experience Redesign",
  eyebrow: "Featured case study",
  subtitle:
    "A travel booking experience shaped through design review, research, journey analysis, accessibility checks, usability validation, prototyping, and developer-ready handover.",
  summary:
    "This case study translates the strongest parts of the earlier slide portfolio into a more modern web story. It focuses on how the product was reviewed, researched, tested, improved, and prepared for implementation across web and mobile surfaces.",
  client: "Travel platform",
  role: "UX & Product Designer",
  duration: "Multi-phase product work",
  team: "Cross-functional collaboration with business and development",
  coverImage: "/images/work/case-marketplace.png",
  coverAlt: "Travel booking flows shown across web and mobile interfaces",
  metrics: [
    { label: "Scale", value: "2M+ downloads" },
    { label: "Surfaces", value: "Web, Android, iOS" },
    { label: "Scope", value: "Review to handover" }
  ],
  outcomes: [
    "Reviewed the existing experience to identify what worked, what created friction, and where assumptions needed to be challenged.",
    "Used research, journey analysis, accessibility checks, and usability validation to improve clarity in decision-heavy moments.",
    "Prepared implementation-ready design assets and state thinking so the work could move more confidently into development."
  ],
  sections: [
    {
      eyebrow: "Design review",
      title: "Review the current experience before redesigning it.",
      body: "The work began with a design review of the existing website and booking experience. The goal was to evaluate what already worked, where the interface created uncertainty, and which parts of the journey still relied on assumptions instead of evidence.",
      note: "The original portfolio showed a large review board. On the site, that same idea becomes easier to understand as a clear product diagnosis.",
      image: "/images/work/case-landing.png",
      imageAlt: "Sample landing page and service entry view"
    },
    {
      eyebrow: "User research",
      title: "Understand the audience behind the current numbers.",
      body: "Research focused on understanding the target demographic, the average user profile, and the business hypotheses behind the product. Surveys, personas, and preference tests helped reveal how users behaved and which interface directions felt more intuitive.",
      note: "The earlier portfolio included persona work and button preference testing. That evidence now supports a more readable research narrative.",
      image: "/images/work/case-filter.png",
      imageAlt: "Sample filter and consent flow"
    },
    {
      eyebrow: "Journey mapping",
      title: "Map how many steps it takes to complete the booking journey.",
      body: "A key part of the process was understanding how users moved through the course booking flow, where they hesitated, and which unhappy paths or error states created unnecessary tension. Journey analysis helped highlight where the experience could be simplified or better supported."
    },
    {
      eyebrow: "Accessibility",
      title: "Treat accessibility and performance as experience quality.",
      body: "Accessibility validation looked at whether content stayed intact, whether contrast and hierarchy stayed readable, whether the interface remained usable with a keyboard, and whether the system still worked across different screen sizes. Performance observations were also used to flag pages that could affect conversion or trust."
    },
    {
      eyebrow: "Usability testing",
      title: "Validate assumptions through multiple lenses.",
      body: "Validation included remote and in-house usability testing, heuristic evaluation, and attitudinal metrics such as SUS, SUPR-Q, CSAT, SEQ, UMUX, and customer feedback. Together, these methods helped turn opinions into concrete experience priorities.",
      image: "/images/work/case-marketplace.png",
      imageAlt: "Travel booking product shown across mobile and web interfaces"
    },
    {
      eyebrow: "Prototyping",
      title: "Use prototypes to refine the right product before release.",
      body: "Prototypes of varying fidelity were used to capture ideas, test changes early, and validate whether proposed interactions actually reduced uncertainty. This helped align product thinking with user needs before development moved too far ahead."
    },
    {
      eyebrow: "Handover",
      title: "Finish with implementation-ready assets and state thinking.",
      body: "The handover phase prepared design assets for development and included user journeys, sitemap logic, content copy, design states, loading states, partial states, error states, and other rules needed to preserve quality during implementation."
    }
  ]
};
---

<BaseLayout title={`${study.title} | Laurenz Gebauer`} description={study.summary} path="/work/school-of-ux-booking/">
  <section class="case-hero panel" data-reveal>
    <div class="case-hero-copy">
      <p class="eyebrow">{study.eyebrow}</p>
      <h1>{study.title}</h1>
      <p class="lede">{study.subtitle}</p>
      <p class="supporting-copy">{study.summary}</p>

      <ul class="case-summary-list" aria-label="Case study facts">
        <li><strong>Client</strong><span>{study.client}</span></li>
        <li><strong>Role</strong><span>{study.role}</span></li>
        <li><strong>Duration</strong><span>{study.duration}</span></li>
        <li><strong>Team</strong><span>{study.team}</span></li>
      </ul>
    </div>

    <div class="case-hero-visual">
      <img src={study.coverImage} alt={study.coverAlt} loading="eager" />
    </div>
  </section>

  <section class="metrics-strip section-space" data-reveal>
    {study.metrics.map((metric) => (
      <article class="metric-card panel">
        <span>{metric.value}</span>
        <p>{metric.label}</p>
      </article>
    ))}
  </section>

  <section class="section-space panel" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Outcomes</p>
      <h2>Why this project matters in the portfolio.</h2>
    </div>

    <div class="outcome-grid">
      {study.outcomes.map((outcome) => (
        <article class="outcome-card">
          <p>{outcome}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-space case-sections" data-reveal>
    {study.sections.map((section, index) => (
      <article class={`case-section panel ${index % 2 === 0 ? "case-section-split" : "case-section-split reverse"}`}>
        <div class="case-section-copy">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
          {section.note && <aside class="inline-note">{section.note}</aside>}
        </div>

        {section.image ? (
          <div class="case-section-visual">
            <img src={section.image} alt={section.imageAlt ?? ""} loading="lazy" />
          </div>
        ) : (
          <div class="case-section-visual case-section-visual-placeholder">
            <div class="placeholder-note">
              <strong>Drop in your supporting asset here</strong>
              <p>
                Replace this placeholder with a screenshot, annotation board, journey map,
                or usability testing artifact from the Figma case study.
              </p>
            </div>
          </div>
        )}
      </article>
    ))}
  </section>

  <section class="panel prose-panel section-space" data-reveal>
    <p class="eyebrow">Case study note</p>
    <p>
      This case study now carries the same core material as the previous slide portfolio, but in a
      more modern format that is easier to read, easier to update, and stronger as a hiring
      artifact. The next improvement step is swapping more of the remaining placeholder visuals
      with your real annotated screenshots.
    </p>
  </section>
</BaseLayout>
