---
import BaseLayout from "../../layouts/BaseLayout.astro";

const study = {
  title: "Food Delivery Comparison Experience",
  eyebrow: "Concept case study",
  subtitle:
    "A professional product concept for helping people compare delivery providers such as Wolt, Lieferando, and local services before they commit to an order.",
  summary:
    "This case study is a portfolio-ready concept built around a realistic problem: food delivery customers often compare providers manually, then discover hidden fees, slow delivery times, or unavailable restaurants too late in the journey.",
  client: "Concept product",
  role: "Product strategy, UX research, mobile UX, prototyping",
  duration: "4-week portfolio sprint",
  team: "Solo concept with AI-assisted research synthesis",
  metrics: [
    { label: "Prototype goal", value: "42% faster comparison" },
    { label: "Providers modeled", value: "3+" },
    { label: "Core journey", value: "Search to confident choice" }
  ],
  outcomes: [
    "Created a clear comparison model for total price, delivery time, service fee, distance, rating, and availability.",
    "Designed mobile-first decision screens that make tradeoffs visible instead of hiding them behind provider-specific checkout flows.",
    "Used AI-assisted synthesis to turn research notes, competitor observations, and edge cases into a structured product direction."
  ],
  sections: [
    {
      eyebrow: "Problem",
      title: "Food delivery comparison is still too manual.",
      body:
        "Customers often open multiple apps, search the same cuisine repeatedly, compare restaurants by memory, and only discover total cost near checkout. The product opportunity is not another delivery app. It is a decision layer that helps users understand which provider is actually best for their current need.",
      visual: "problem"
    },
    {
      eyebrow: "Research framing",
      title: "The key question is not cheapest or fastest. It is confidence.",
      body:
        "The concept focuses on decision confidence: can a user quickly understand the best available option for their context? Research assumptions were grouped into four signals: total cost, realistic ETA, restaurant availability, and trust indicators such as ratings or cancellation risk.",
      visual: "signals"
    },
    {
      eyebrow: "AI-assisted workflow",
      title: "AI helps structure complexity before design starts.",
      body:
        "AI was used as a workflow accelerator: clustering competitor observations, extracting repeated user frustrations, generating edge-case checklists, and drafting comparison rules. The design decisions remain human-led, but the preparation becomes faster and more systematic.",
      visual: "ai"
    },
    {
      eyebrow: "Experience design",
      title: "The mobile flow reduces provider hopping.",
      body:
        "The proposed flow starts with one query, then compares matching restaurants across providers. Each result explains why it is recommended: faster delivery, lower total cost, better rating, or better reliability. Users can filter by what matters most instead of scanning separate apps.",
      visual: "phones"
    },
    {
      eyebrow: "Validation plan",
      title: "Testing would focus on tradeoff clarity.",
      body:
        "The prototype would be tested with task-based sessions: choose dinner for two under EUR 25, find the fastest vegan option, or compare a known restaurant across providers. Success would be measured by time to decision, perceived confidence, and whether users notice fees before checkout.",
      visual: "testing"
    },
    {
      eyebrow: "Handoff",
      title: "The concept is designed to become implementation-ready.",
      body:
        "The next production step would define provider data states, unavailable-result fallbacks, loading behavior, fee transparency rules, and error handling. This is where my IT and mobile background becomes useful: the UI is designed with API uncertainty and real product constraints in mind.",
      visual: "handover"
    }
  ]
};
---

<BaseLayout title={`${study.title} | Laurenz Gebauer`} description={study.summary} path="/work/school-of-ux-booking/">
  <section class="case-hero panel delivery-case-hero" data-reveal>
    <div class="case-hero-copy">
      <p class="eyebrow">{study.eyebrow}</p>
      <h1>{study.title}</h1>
      <p class="lede">{study.subtitle}</p>
      <p class="supporting-copy">{study.summary}</p>

      <ul class="case-summary-list" aria-label="Case study facts">
        <li><strong>Client</strong><span>{study.client}</span></li>
        <li><strong>Role</strong><span>{study.role}</span></li>
        <li><strong>Duration</strong><span>{study.duration}</span></li>
        <li><strong>Team</strong><span>{study.team}</span></li>
      </ul>
    </div>

    <div class="delivery-hero-visual" aria-label="Mobile delivery comparison concept preview">
      <div class="delivery-screen screen-main">
        <div class="screen-header">
          <span>Tonight in Vienna</span>
          <strong>Best delivery match</strong>
        </div>
        <div class="provider-card provider-card-winner">
          <span>Wolt</span>
          <strong>Spicy Ramen House</strong>
          <p>24 min - EUR 15.80 total - 4.7 rating</p>
        </div>
        <div class="provider-card">
          <span>Lieferando</span>
          <strong>Spicy Ramen House</strong>
          <p>31 min - EUR 13.40 total - 4.5 rating</p>
        </div>
        <div class="provider-card">
          <span>Local courier</span>
          <strong>Unavailable</strong>
          <p>Kitchen closed until 18:00</p>
        </div>
      </div>
      <div class="delivery-screen screen-side">
        <span class="phone-pill">AI summary</span>
        <strong>Choose Wolt if speed matters. Choose Lieferando if price matters.</strong>
      </div>
    </div>
  </section>

  <section class="metrics-strip section-space" data-reveal>
    {study.metrics.map((metric) => (
      <article class="metric-card panel">
        <span>{metric.value}</span>
        <p>{metric.label}</p>
      </article>
    ))}
  </section>

  <section class="section-space panel" data-reveal>
    <div class="section-intro">
      <p class="eyebrow">Outcomes</p>
      <h2>A concept that feels realistic, not decorative.</h2>
    </div>

    <div class="outcome-grid">
      {study.outcomes.map((outcome) => (
        <article class="outcome-card">
          <p>{outcome}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-space case-sections" data-reveal>
    {study.sections.map((section, index) => (
      <article class={`case-section panel ${index % 2 === 0 ? "case-section-split" : "case-section-split reverse"}`}>
        <div class="case-section-copy">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </div>

        <div class={`case-artifact case-artifact-${section.visual}`} aria-hidden="true">
          {section.visual === "problem" && (
            <>
              <div class="app-stack-card">Wolt</div>
              <div class="app-stack-card">Lieferando</div>
              <div class="app-stack-card">Restaurant app</div>
              <p>Same craving, three different totals.</p>
            </>
          )}

          {section.visual === "signals" && (
            <>
              <div class="signal-row"><span>Total cost</span><strong>EUR 15.80</strong></div>
              <div class="signal-row"><span>Delivery ETA</span><strong>24 min</strong></div>
              <div class="signal-row"><span>Availability</span><strong>Open now</strong></div>
              <div class="signal-row"><span>Trust</span><strong>4.7 rating</strong></div>
            </>
          )}

          {section.visual === "ai" && (
            <>
              <span class="ai-chip">Research notes</span>
              <span class="ai-chip">Competitor patterns</span>
              <span class="ai-chip">Edge cases</span>
              <span class="ai-chip">Decision rules</span>
              <p>AI structures the messy input. UX decides what matters.</p>
            </>
          )}

          {section.visual === "phones" && (
            <div class="phone-row">
              <div class="mini-phone"><span>Search</span><strong>Sushi near me</strong></div>
              <div class="mini-phone"><span>Compare</span><strong>Fee + ETA</strong></div>
              <div class="mini-phone"><span>Choose</span><strong>Best match</strong></div>
            </div>
          )}

          {section.visual === "testing" && (
            <>
              <div class="test-card"><strong>Task 01</strong><span>Dinner under EUR 25</span></div>
              <div class="test-card"><strong>Task 02</strong><span>Fastest vegan option</span></div>
              <div class="test-card"><strong>Task 03</strong><span>Spot checkout fees</span></div>
            </>
          )}

          {section.visual === "handover" && (
            <>
              <div class="handover-grid">
                <span>Loading</span>
                <span>Unavailable</span>
                <span>Price changed</span>
                <span>Provider error</span>
              </div>
              <p>Design states are prepared for real API behavior.</p>
            </>
          )}
        </div>
      </article>
    ))}
  </section>

  <section class="panel prose-panel section-space" data-reveal>
    <p class="eyebrow">Next asset step</p>
    <p>
      This page is ready for real screenshots later. Once you provide phone mockups or app screens,
      the CSS concept visuals can be replaced with polished product images while keeping the same
      case-study structure.
    </p>
  </section>
</BaseLayout>
